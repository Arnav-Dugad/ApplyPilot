{
  "name": "applypilot",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "python3 -m backend.server",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:backend": "python3 -m unittest discover -s backend/tests -v",
    "test:all": "npm run test && npm run test:backend",
    "check": "npm run build && npm run test:all",
    "desktop": "npm run build && python -m backend.desktop",
    "package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File packaging/build.ps1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.2",
    "d3-geo": "^3.1.1",
    "lucide-react": "0.544.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "topojson-client": "^3.1.0",
    "typescript": "5.9.2",
    "vite": "7.1.7",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/topojson-client": "^3.1.5",
    "jsdom": "26.1.0",
    "vitest": "3.2.4"
  }
}
